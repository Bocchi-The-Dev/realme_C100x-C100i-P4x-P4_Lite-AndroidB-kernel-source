#if (defined(CONFIG_SND_SOC_AK4377_HIFI) || defined(CONFIG_SND_SOC_AK4377_HIFI_MODULE))
#if (defined(CONFIG_SND_SOC_UMS9230_AK4377_HIFI) || defined(CONFIG_SND_SOC_UMS9230_AK4377_HIFI_MODULE))
&i2c4 {
	clock-names ="enable", "i2c", "source";
	clocks = <&apapb_gate CLK_I2C4_EB>,
		 <&ap_clk CLK_AP_I2C4>, <&ext_26m>;

	ak4377_hifi: ak4377@10 {
		compatible = "akm,ak4376";
		reg = <0x10>;
		#sound-dai-cells = <1>;
		vddldo1-supply = <&vddldo1>;
		sprd,vddldo1-voltage = <1800000>;
		ak4377,pdn-gpio = <&ap_gpio 129 GPIO_ACTIVE_HIGH>;

		clock-names = "clk_48M", "source", "enable";
		clocks = <&aon_clk CLK_AUX1>,
			 <&pll1 CLK_TWPLL_19M2>,
			 <&aonapb_gate CLK_AUX1_EB>;
	};
};
#endif

#if (defined(CONFIG_SND_SOC_UMS9620_AK4377_HIFI) || defined(CONFIG_SND_SOC_UMS9620_AK4377_HIFI_MODULE))
&i2c1 {
	//clock-names = "enable", "i2c", "source";
	//clocks = <&apahb_gate CLK_I2C1_EB>,
	//	 <&ap_clk CLK_AP_I2C1>, <&ext_26m>;
	status = "okay";
	clock-frequency = <400000>;

	ak4377_hifi: ak4377@10 {
		compatible = "akm,ak4376";
		reg = <0x10>;
		#sound-dai-cells = <1>;
		vddldo1-supply = <&vddldo3>;
		sprd,vddldo1-voltage = <1800000>;
		ak4377,pdn-gpio = <&ap_gpio 108 GPIO_ACTIVE_HIGH>;

        clock-names = "clk_48M", "source", "enable";
        clocks = <&aonapb_gate CLK_AUX2>,
              <&g5r_pll CLK_AUDPLL_19M2>,
            <&aonapb_gate CLK_AUX2_EB>;
	};
};
#endif

&sound_vbc_v4_sprd_codec {
	/* 38: akm hifi normal ap01 */
	sprd-audio-card,dai-link@56 {
		ignore-suspend = <1>;
		link-name = "BE_NORMAL_AP01_HIFI";
		stream-name = "BE_ST_NORMAL_AP01_HIFI";
		no-pcm = <1>;
		dpcm-playback = <1>;
		be-id = <0>;
		dai-format = "i2s";
		plat {
			sound-dai = <&sprd_route_pcm>;
		};
		cpu {
			sound-dai = <&vbc_v4 34>;
		};
		codec {
			sound-dai = <&ak4377_hifi 0>;
		};
	};

	/* 39: akm hifi normal ap23 */
	sprd-audio-card,dai-link@57 {
		ignore-suspend = <1>;
		link-name = "BE_NORMAL_AP23_HIFI";
		stream-name = "BE_ST_NORMAL_AP23_HIFI";
		no-pcm = <1>;
		dpcm-playback = <1>;
		be-id = <0>;
		dai-format = "i2s";
		plat {
			sound-dai = <&sprd_route_pcm>;
		};
		cpu {
			sound-dai = <&vbc_v4 35>;
		};
		codec {
			sound-dai = <&ak4377_hifi 1>;
		};
	};

	/* 40: akm hifi fast playback */
	sprd-audio-card,dai-link@58 {
		ignore-suspend = <1>;
		link-name = "BE_FAST_P_HIFI";
