	};

	/* 54: be dsp HIFI fast*/
	sprd-audio-card,dai-link@72 {
		ignore-suspend = <1>;
		link-name = "BE_HIFI_FAST_P";
		stream-name = "BE_ST_HIFI_FAST_P";
		no-pcm = <1>;
