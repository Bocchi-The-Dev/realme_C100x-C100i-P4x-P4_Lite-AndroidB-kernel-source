		};
	};

	/* 55: fe dsp hifi fast*/
	sprd-audio-card,dai-link@73 {
		link-name = "FE_HIFI_FAST_P";
		stream-name = "FE_ST_HIFI_FAST_P";
		ignore-suspend = <1>;
