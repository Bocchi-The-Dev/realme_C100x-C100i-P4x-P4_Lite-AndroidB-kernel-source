	};

	/* dai-link@53 ~ dai-link@67 (index from 35 to 49)
	 * are reserved for ucp1301 and vbc HIFI.
	 */

	/* 52: fe dsp hifi */
	sprd-audio-card,dai-link@70 {
		link-name = "FE_HIFI_P";
		stream-name = "FE_ST_HIFI_P";
		ignore-suspend = <1>;
		dynamic = <1>;
		trigger = <1 1>;
		dpcm-playback = <1>;
		be-id = <0>;
		plat {
			sound-dai = <&sprd_pcm>;
		};
		cpu {
			sound-dai = <&sprd_fe_dai 22>;
		};
		codec {
			sound-dai = <0 0>;
		};
	};

	/* 53: be dsp HIFI */
	sprd-audio-card,dai-link@71 {
		ignore-suspend = <1>;
		link-name = "BE_HIFI_P";
