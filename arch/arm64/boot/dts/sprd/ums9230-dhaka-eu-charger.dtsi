&charger {
	battery2 {
		io-channels = <&pmic_adc 6>, <&pmic_adc 4>, <&pmic_adc 14>;
		io-channel-names = "usb_temp_v_l", "usb_temp_v_r", "charge_vbus";
		//for oplus chg framework:
