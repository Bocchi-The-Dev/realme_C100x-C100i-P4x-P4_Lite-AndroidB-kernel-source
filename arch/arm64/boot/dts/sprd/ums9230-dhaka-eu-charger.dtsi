	qcom,ff1_exit_step_ma = <200>;
	qcom,ff1_warm_exit_step_ma = <200>;

	qcom,ffc2_normal_fastchg_ma = <750>;/*12C~35c*/
	qcom,ffc2_warm_fastchg_ma = <850>;	/* 35C ~ 40c */
	qcom,ffc2_temp_warm_decidegc = <350>;
