&i2c6 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;
	dma-names = "no_rx_dma", "no_tx_dma";
	dmas = <&ap_dma 35 &ap_dma 36>;
	sc8547charger: sc8547-charger@6F{
		status = "okay";
		compatible = "oplus,sc8547a-ufcs";
		reg = <0x6F 0>;
		ocp_reg = <0xC>;
		ovp_reg = <0x36>;	/* 4.85V */

		qcom,remove_otg_en;

		qcom,irq_gpio = <&ap_gpio 126 0x00>;/*CP1_EINT*/
		qcom,external_gauge_support;
		interrupt-parent = <&ap_gpio>;
		interrupts = <126 0>;

		/*pinctrl-names = "switch1_act_switch2_act", "switch1_sleep_switch2_sleep",
					"charging_inter_active", "charging_inter_sleep";
		pinctrl-0 = <&charging_switch1_active>;
		pinctrl-1 = <&charging_switch1_sleep>;
		pinctrl-2 = <&charging_inter_active>;
		pinctrl-3 = <&charging_inter_sleep>;*/

		qcom,charging_switch1-gpio = <&ap_gpio 165 0x00>;

		qcom,copycat_vooc_support;
		/*qcom,voocphy_dual_cp_support;*/
		qcom,slave_cp_enable_thr = <1900>;		//2000-100mA
		qcom,slave_cp_disable_thr_high = <1600>;	//1500+100mA
		qcom,voocphy_current_default = <41>;

		qcom,svooc_cool_down_current_limit = <82 20 20 24 30 34 40 44 50 54 60 64 70 74 80>;
		qcom,vooc_cool_down_current_limit = <30 20 20 20 30 30 30 30 30 30 30 30 30 30 30>;
		qcom,abnormal_adapter_current = <41 41 40 40 30 30 20 20>;

		qcom,vooc_multistep_initial_batt_temp = <1000>;

		qcom,vooc_strategy_normal_current = <100>;
		qcom,vooc_normal_to_little_cool_current = <100>;
		qcom,vooc_batt_over_high_temp = <510>;

		qcom,vooc-low-temp = <0>;
		qcom,vooc-high-temp = <500>;
		qcom,vooc-low-soc = <0>;
		qcom,vooc-high-soc = <90>;
		qcom,vooc-warm-allow-vol = <4000>;
		qcom,vooc-warm-allow-soc = <50>;

		qcom,vooc_little_cold_temp = <50>;
		qcom,vooc_cool_temp = <120>;
		qcom,vooc_little_cool_temp = <200>;
		qcom,vooc_normal_low_temp = <350>;
		qcom,vooc-normal-high-temp = <440>;

		qcom,vooc_strategy1_batt_high_temp0 = <400>;
		qcom,vooc_strategy1_batt_high_temp1 = <420>;
		qcom,vooc_strategy1_batt_high_temp2 = <430>;
		qcom,vooc_strategy1_batt_low_temp2 = <420>;
		qcom,vooc_strategy1_batt_low_temp1 = <410>;
		qcom,vooc_strategy1_batt_low_temp0 = <390>;

		qcom,vooc_strategy1_high_current0 = <50>;
		qcom,vooc_strategy1_high_current1 = <40>;
		qcom,vooc_strategy1_high_current2 = <20>;
		qcom,vooc_strategy1_low_current2 = <40>;
		qcom,vooc_strategy1_low_current1 = <50>;
		qcom,vooc_strategy1_low_current0 = <60>;

		qcom,voocphy_freq_mincore = <1800000>;
		qcom,voocphy_freq_midcore = <1800000>;
		qcom,voocphy_freq_maxcore = <1800000>;
		qcom,voocphy_current_change_timeout = <100>;

		oplus,workaround_for_100w;

		qcom,voocphy_ibat_over_current = <8500>;
		qcom,voocphy_svooc_cp_max_ibus = <4500>;
		qcom,voocphy_vooc_cp_max_ibus = <3500>;
		qcom,voocphy_cp_max_ibus = <4500>;

		qcom,vooc_little_cold_full_voltage = <4150>;
		qcom,vooc_cool_full_voltage = <4500>;
		qcom,vooc_warm_full_voltage = <4130>;
		qcom,vooc_1time_full_voltage = <4500>;
		qcom,vooc_ntime_full_voltage = <4500>;
		qcom,low_curr_full_t1 = <120>;
		qcom,low_curr_full_t2 = <350>;
		qcom,low_curr_full_t3 = <440>;
		qcom,range1_low_curr_full = <750 4500
						705 4495
						660 4480
						615 4470
						570 4460>;
		qcom,range2_low_curr_full = <850 4500
						805 4495
						760 4480
						715 4470
						670 4460>;

		svooc_batt_sys_curve = <0 1 0 1 0 0 0	// 4000mA
					1 1 1 1 0 0 0	// 4604mV
					0 0 1 1 0 1 0	// 2600mA
					1 1 1 1 0 0 0	// 4604mV
					0 0 0 1 0 1 1	// 1100mA
					1 1 1 1 0 0 0>;	// 4604mV

		vooc_batt_sys_curve =  <0 1 0 1 0 0 0	// 4000mA
					1 1 1 1 0 0 0	// 4604mV
					0 0 1 1 0 1 0	// 2600mA
					1 1 1 1 0 0 0	// 4604mV
					0 0 0 1 0 1 1	// 1100mA
					1 1 1 1 0 0 0>;	// 4604mV

		svooc_charge_strategy {
			strategy_soc_0_to_50 {
				strategy_temp_little_cold =	<4140 13 0 0 0
								 4150 10 1 0 0>;
				strategy_temp_cool =	<4150 22 0 0 0
								 4460 22 0 0 0
								 4460 20 0 0 0
								 4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_little_cool =	<4150 22 0 0 0
								 4460 22 0 0 0
								 4460 20 0 0 0
								 4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_normal_low =	<4150 41 0 60 0
								 4150 30 0 1200 0
								 4230 27 0 0 0
								 4230 25 0 1200 0
								 4460 22 0 0 0
								 4460 20 0 0 0
								 4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_normal_high =	<4150 41 0 60 0
								 4150 30 0 1200 0
								 4230 27 0 0 0
								 4230 25 0 1200 0
								 4460 22 0 0 0
								 4460 20 0 0 0
								 4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_warm = <4120 16 0 0 0
								 4120 15 0 0 0
								 4130 10 1 0 0>;
			};

			strategy_soc_50_to_75 {
				strategy_temp_little_cold =	<4150 10 1 0 0>;
				strategy_temp_cool =	<4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_little_cool =	<4460 20 0 0 0
								 4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_normal_low =	<4230 25 0 0 0
								 4460 22 0 0 0
								 4460 20 0 0 0
								 4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_normal_high =	<4230 25 0 0 0
								 4460 22 0 0 0
								 4460 20 0 0 0
								 4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_warm = <4130 15 1 0 0>;
			};

			strategy_soc_75_to_85 {
				strategy_temp_little_cold =	<4150 10 1 0 0>;
				strategy_temp_cool =	<4500 10 1 0 0>;
				strategy_temp_little_cool =	<4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_normal_low =	<4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_normal_high =	<4460 15 0 0 0
								 4490 13 0 0 0
								 4500 10 1 0 0>;
				strategy_temp_warm = <4130 15 1 0 0>;
			};

			strategy_soc_85_to_90 {
				strategy_temp_little_cold =	<4150 10 1 0 0>;
				strategy_temp_cool =		<4500 10 1 0 0>;
				strategy_temp_little_cool =	<4500 10 1 0 0>;
				strategy_temp_normal_low =	<4500 10 1 0 0>;
				strategy_temp_normal_high =	<4500 10 1 0 0>;
				strategy_temp_warm = 		<4130 15 1 0 0>;
			};
		};

		vooc_charge_strategy {
			strategy_soc_0_to_50 {
				strategy_temp_little_cold =	<4140 26 0 0 0
								 4150 20 1 0 0>;			/*0-5C*/
				strategy_temp_cool =	<4460 30 0 0 0
								 4490 26 0 0 0
								 4500 20 1 0 0>;			/*5-12C*/
				strategy_temp_little_cool =	<4460 30 0 0 0
								 4490 26 0 0 0
								 4500 20 1 0 0>;			/*12-20C*/
				strategy_temp_normal_low =	<4460 30 0 0 0
								 4490 26 0 0 0
								 4500 20 1 0 0>;			/*20-35C*/
				strategy_temp_normal_high =	<4460 30 0 0 0
								 4490 26 0 0 0
								 4500 20 1 0 0>;			/*35C-44C*/
