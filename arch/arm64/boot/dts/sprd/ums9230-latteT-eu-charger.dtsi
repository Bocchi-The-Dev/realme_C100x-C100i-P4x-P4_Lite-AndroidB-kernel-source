	qcom,input_current_vooc_ma_warm = <3200>;
	qcom,input_current_vooc_ma_high = <2200>;

	qcom,overtemp_bat_decidegc = <350>;
	qcom,iterm_disabled = <0>;
	//sw_full_count = <25>;
	qcom,iterm_ma = <302>;
	qcom,recharge-mv = <100>;

	qcom,batt_capacity_mah = <6000>; /*typical capacity*/
	//qcom,batt_capacity_mah = <4870>; /*rated capacity*/
	qcom,usb_high_than_bat_decidegc = <168>;

	qcom,removed_bat_decidegc = <390>;  /* < -39C */

	qcom,cold_bat_decidegc = <100>;  /* -10C ~ 0C */
	qcom,temp_cold_vfloat_mv = <4464>;
	qcom,temp_freeze_fastchg_current_ma_high = <1166>;
	qcom,temp_freeze_fastchg_current_ma_low = <874>;
	qcom,temp_freeze_fastchg_current_ma = <1166>;
	qcom,temp_cold_fastchg_current_ma_high = <1166>;
	qcom,temp_cold_fastchg_current_ma_low = <874>;
	qcom,temp_cold_fastchg_current_ma = <1166>;
	qcom,qc_temp_freeze_fastchg_current_ma_high = <1166>;
	qcom,qc_temp_freeze_fastchg_current_ma_low = <874>;
	qcom,pd_temp_freeze_fastchg_current_ma_high = <1166>;
	qcom,pd_temp_freeze_fastchg_current_ma_low = <874>;

	qcom,little_cold_bat_decidegc = <0>;    /* 0C ~ 5C */
	qcom,temp_little_cold_vfloat_mv = <4464>;
	qcom,temp_little_cold_fastchg_current_ma_high = <3000>;
	qcom,temp_little_cold_fastchg_current_ma_low = <2623>;
	qcom,temp_little_cold_fastchg_current_ma = <3000>;
	qcom,qc_temp_little_cold_fastchg_current_ma_high = <3000>;
	qcom,qc_temp_little_cold_fastchg_current_ma_low = <2623>;
	qcom,pd_temp_little_cold_fastchg_current_ma_high = <3000>;
	qcom,pd_temp_little_cold_fastchg_current_ma_low = <2623>;

	qcom,cool_bat_decidegc = <50>;  /* 5C ~ 12C */
	qcom,temp_cool_vfloat_mv = <4464>;
	qcom,temp_cool_fastchg_current_ma_high = <3000>;
	qcom,temp_cool_fastchg_current_ma_low = <3000>;
	qcom,qc_temp_cool_fastchg_current_ma_high = <3000>;
	qcom,qc_temp_cool_fastchg_current_ma_low = <3000>;
	qcom,pd_temp_cool_fastchg_current_ma_high = <3000>;
	qcom,pd_temp_cool_fastchg_current_ma_low = <3000>;

	qcom,little_cool_bat_decidegc = <120>;  /* 12C ~ 16C */
	qcom,temp_little_cool_vfloat_mv = <4464>;
